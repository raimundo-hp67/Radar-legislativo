# ── Requerido ─────────────────────────────────────────────────────────────
# Postgres. El valor por defecto coincide con el contenedor de `docker compose up`.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Secreto de sesión de BetterAuth (REQUERIDO, mínimo 32 caracteres).
# Genera uno con: openssl rand -base64 32
BETTER_AUTH_SECRET=

# URL base de la app (en producción: https://tu-dominio.com)
BETTER_AUTH_URL=http://localhost:3000

# ── Opcional: alertas a Slack ─────────────────────────────────────────────
# Incoming Webhook de Slack (https://api.slack.com/messaging/webhooks).
# Sin esto la app funciona igual; solo se omiten alertas y resumen semanal.
SLACK_WEBHOOK_URL=

# ── Opcional: agentes de análisis con IA ──────────────────────────────────
# API key de OpenAI (https://platform.openai.com/api-keys).
# Habilita los chats de análisis en Proyectos, Investigación y Lobby.
OPENAI_API_KEY=

# ── Opcional: fuente oficial de Ley de Lobby ──────────────────────────────
# API key de https://www.leylobby.gob.cl/api (se solicita en el portal).
# Sin ella, el módulo de lobby usa el feed público de InfoLobby como fuente.
LEYLOBBY_API_KEY=
# Códigos de institución a sincronizar, separados por coma (ej: AI060,AE001)
LEYLOBBY_INSTITUCIONES=

# ── Opcional: cron / polling ──────────────────────────────────────────────
# Protege /api/legal/poll (polling manual vía curl o cron externo).
LEGAL_POLL_API_KEY=change-me-in-production

# Solo para deploy en Vercel: protege los endpoints /api/cron/* (Vercel lo
# envía automáticamente si defines CRON_SECRET en el dashboard del proyecto).
CRON_SECRET=
