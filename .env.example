DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# Optional: restrict signups to a single email domain (shown in the signup form)
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=

# Legal Tracker
SLACK_WEBHOOK_URL=
LEGAL_POLL_API_KEY=change-me-in-production

# Vercel Cron (set this in Vercel dashboard)
CRON_SECRET=

# OpenAI (optional, enables the analysis chat agents)
OPENAI_API_KEY=

# Official Ley de Lobby API (optional; falls back to InfoLobby when unset)
LEYLOBBY_API_KEY=
LEYLOBBY_INSTITUCIONES=
