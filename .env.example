# ── Requerido ─────────────────────────────────────────────────────────────
# Postgres. El valor por defecto coincide con el contenedor de `docker compose up`.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Secreto de sesión de BetterAuth (REQUERIDO, mínimo 32 caracteres).
# Genera uno con: openssl rand -base64 32
BETTER_AUTH_SECRET=

# URL base de la app. Para uso local no hay que tocarla; si despliegas tu
# propia copia (ej: Vercel), pon la URL exacta que te asignen, sin / final.
BETTER_AUTH_URL=http://localhost:3000

# ── Opcional: Google SSO ──────────────────────────────────────────────────
# Credenciales OAuth de Google Cloud Console (APIs & Services → Credentials).
# Con ambas definidas aparece el botón "Continuar con Google" en el login.
# Redirect URI a registrar: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Dominio de email cuyos usuarios se auto-registran en su primer login con
# Google (ej: tuempresa.com). Sin esto, NADIE puede crear cuenta (ni por SSO).
AUTH_ALLOWED_EMAIL_DOMAIN=

# ── Registro de cuentas ───────────────────────────────────────────────────
# Con "1" (el valor por defecto de la instalación local), cualquier persona
# que llegue a la app puede crear su propia cuenta desde /signup. Cada cuenta
# ve SOLO sus propios proyectos y notas, así que compartir la instalación (o
# la repo) es seguro: cada abogado tiene su radar privado.
# Déjalo vacío para cerrar el registro: solo se podrá crear la PRIMERA cuenta
# desde el navegador y las siguientes con scripts/create-user.ts.
# Se ignora si defines AUTH_ALLOWED_EMAIL_DOMAIN (ese modo manda).
AUTH_OPEN_SIGNUP=1

# ── Opcional: alertas a Slack ─────────────────────────────────────────────
# Incoming Webhook de Slack (https://api.slack.com/messaging/webhooks).
# Sin esto la app funciona igual; solo se omiten alertas y resumen semanal.
SLACK_WEBHOOK_URL=

# ── Opcional: agentes de análisis con IA ──────────────────────────────────
# API key de OpenAI (https://platform.openai.com/api-keys).
# Habilita los chats de análisis en Proyectos, Investigación y Lobby.
OPENAI_API_KEY=

# ── Opcional: fuente oficial de Ley de Lobby ──────────────────────────────
# API key de https://www.leylobby.gob.cl/api (se solicita en el portal).
# Sin ella, el módulo de lobby usa el feed público de InfoLobby como fuente.
LEYLOBBY_API_KEY=
# Códigos de institución a sincronizar, separados por coma (ej: AI060,AE001)
LEYLOBBY_INSTITUCIONES=

# ── Opcional: actualización automática ────────────────────────────────────
# Cada cuántas HORAS la app refresca sola proyectos de ley, lobby y el
# catálogo de boletines mientras está corriendo (en un deploy en Vercel lo
# hacen los cron jobs de vercel.json, así que ahí se ignora).
# Pon 0 para desactivar. Si no se define, el valor por defecto es 6.
AUTO_UPDATE_INTERVAL_HOURS=6

# ── Opcional: cron / polling ──────────────────────────────────────────────
# Protege /api/legal/poll (polling manual vía curl o cron externo).
LEGAL_POLL_API_KEY=change-me-in-production

# Solo para tu propio deploy en Vercel: protege los endpoints /api/cron/*
# (Vercel lo envía automáticamente si defines CRON_SECRET en el dashboard
# del proyecto). Para uso local no hace falta.
CRON_SECRET=

# Solo si abres la app desde OTRA dirección además de BETTER_AUTH_URL:
# otro computador de tu red (http://192.168.1.10:3000) o, en un deploy, un
# dominio propio además del *.vercel.app asignado. Sin esto, cualquier otra
# URL da error "Invalid origin". Formato: URLs separadas por coma.
ADDITIONAL_TRUSTED_ORIGINS=

# Solo si sirves la app DETRÁS de un proxy de confianza (nginx, Caddy) que
# reescriba X-Forwarded-For: ponlo en 1 para que el rate limiting use la IP
# real del cliente. En Vercel no hace falta; sin proxy, déjalo vacío.
TRUST_PROXY=
