# ── Requerido ─────────────────────────────────────────────────────────────
# Postgres. El valor por defecto coincide con el contenedor de `docker compose up`.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Secreto de sesión de BetterAuth (REQUERIDO, mínimo 32 caracteres).
# Genera uno con: openssl rand -base64 32
BETTER_AUTH_SECRET=

# URL base de la app (en producción: https://tu-dominio.com)
BETTER_AUTH_URL=http://localhost:3000

# ── Opcional: Google SSO ──────────────────────────────────────────────────
# Credenciales OAuth de Google Cloud Console (APIs & Services → Credentials).
# Con ambas definidas aparece el botón "Continuar con Google" en el login.
# Redirect URI a registrar: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Dominio de email cuyos usuarios se auto-registran en su primer login con
# Google (ej: tuempresa.com). Sin esto, NADIE puede crear cuenta (ni por SSO).
AUTH_ALLOWED_EMAIL_DOMAIN=

# ── Opcional: registro abierto a la comunidad ─────────────────────────────
# Pon "1" para que CUALQUIERA pueda crear su cuenta con email + contraseña
# desde /signup (herramienta pública y gratuita). Si dejas esto vacío, solo
# se puede crear la PRIMERA cuenta desde el navegador y luego se cierra.
# Se ignora si defines AUTH_ALLOWED_EMAIL_DOMAIN (ese modo manda).
AUTH_OPEN_SIGNUP=

# ── Opcional: alertas a Slack ─────────────────────────────────────────────
# Incoming Webhook de Slack (https://api.slack.com/messaging/webhooks).
# Sin esto la app funciona igual; solo se omiten alertas y resumen semanal.
SLACK_WEBHOOK_URL=

# ── Opcional: agentes de análisis con IA ──────────────────────────────────
# API key de OpenAI (https://platform.openai.com/api-keys).
# Habilita los chats de análisis en Proyectos, Investigación y Lobby.
OPENAI_API_KEY=

# ── Opcional: fuente oficial de Ley de Lobby ──────────────────────────────
# API key de https://www.leylobby.gob.cl/api (se solicita en el portal).
# Sin ella, el módulo de lobby usa el feed público de InfoLobby como fuente.
LEYLOBBY_API_KEY=
# Códigos de institución a sincronizar, separados por coma (ej: AI060,AE001)
LEYLOBBY_INSTITUCIONES=

# ── Opcional: actualización automática ────────────────────────────────────
# Cada cuántas HORAS la app refresca sola proyectos de ley y lobby mientras
# está corriendo (solo local/self-hosted; en Vercel lo hacen los cron jobs).
# Pon 0 para desactivar. Si no se define, el valor por defecto es 6.
AUTO_UPDATE_INTERVAL_HOURS=6

# ── Opcional: cron / polling ──────────────────────────────────────────────
# Protege /api/legal/poll (polling manual vía curl o cron externo).
LEGAL_POLL_API_KEY=change-me-in-production

# Solo para deploy en Vercel: protege los endpoints /api/cron/* (Vercel lo
# envía automáticamente si defines CRON_SECRET en el dashboard del proyecto).
CRON_SECRET=

# Solo si publicaste la app en MÁS de un dominio (ej: tu dominio propio Y el
# *.vercel.app que Vercel asigna). Sin esto, el login solo funciona desde la
# URL exacta de BETTER_AUTH_URL — cualquier otra da error "Invalid origin".
# Formato: URLs separadas por coma, con https:// incluido.
ADDITIONAL_TRUSTED_ORIGINS=

# Solo self-hosted DETRÁS de un proxy de confianza (nginx, Caddy) que reescriba
# X-Forwarded-For: ponlo en 1 para que el rate limiting use la IP real del
# cliente. En Vercel no hace falta; sin proxy, déjalo vacío.
TRUST_PROXY=
