# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# log de la carga del catálogo en segundo plano (scripts/setup.sh)
.radar-catalogo.log

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example


# typescript
*.tsbuildinfo
next-env.d.ts

# package manager lock files (project uses bun)
yarn.lock
.cursor/debug.log
tmp/
.claude/worktrees/
